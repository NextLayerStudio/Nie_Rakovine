# Neon (Vercel Postgres) connection string for Prisma
# Pooled connection used by app (Prisma serverless friendly)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct connection used by Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth — session signing (>= 16 chars)
AUTH_SECRET="change-me-long-random-string"

# Staff site gate — while the app isn't publicly launched, only /podujatia
# is public. Every other page redirects to /access, which prompts for
# STAFF_PASSWORD; on success it sets a cookie containing STAFF_BYPASS_TOKEN
# (an internal secret, never shown to the user) that unlocks the rest of
# the site for 30 days. Generate STAFF_BYPASS_TOKEN with: openssl rand -hex 24
STAFF_BYPASS_TOKEN="change-me-long-random-string"
STAFF_PASSWORD="change-me-human-facing-password"
# Set to true in local .env to skip the /access password gate entirely
STAFF_GATE_DISABLED="true"

# Public app URL (used in email links)
APP_URL="http://localhost:3000"

# Legacy / optional
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Admin bootstrap (used by seed script)
ADMIN_EMAIL="admin@onkoklub.sk"
ADMIN_PASSWORD="change-me-strong-password"

# Resend — transactional email
# Get API key: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Must use a domain verified in Resend (or onboarding@resend.dev for testing to your own inbox)
EMAIL_FROM="Onko Klub <noreply@yourdomain.sk>"

# Upstash Redis — rate limiting (login, registration, reset password)
# Vercel Upstash integration usually sets KV_REST_API_* or Upstash_KV_REST_API_*.
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# MailerLite — newsletter opt-in sync (consentNewsletter checkbox at
# registration and in Nastavenia → Notifikácie adds the member to the
# "ONKO KLUB - Newsletter" group). Leave unset to skip the sync silently.
MAILERLITE_API_KEY=""

# Nexi XPay — card payment gateway. Leave unset to keep the existing
# instant-activate checkout behaviour (used until we're ready to go live
# with real charges). Test/sandbox values while integrating:
# Base URL: https://xpaysandbox.nexigroup.com/api/phoenix-0.0/psp/api/v1
NEXI_API_KEY=""
NEXI_BASE_URL=""

# Secret shared with Vercel Cron so only Vercel can trigger
# /api/cron/renew-subscriptions (Vercel sends it as "Authorization: Bearer
# <value>" automatically once this env var exists). Generate with:
# openssl rand -hex 24
CRON_SECRET=""
